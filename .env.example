# Required
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=ghp_...

# Public base URL of THIS runtime (e.g. https://agents.yourco.com). Anything that
# writes a target into your repo or into GitHub reads it ONLY from here, never
# from a request header, so a forged x-forwarded-host cannot steer it. Unset, the
# two write paths degrade differently: POST /api/projects still creates the agent
# and the project and answers 200, but skips the webhook and reports
# `webhookSkipped: "base_url_not_configured"`; GET /api/github/install answers 412,
# because an OAuth flow has no way to continue without a callback URL. Read-only
# surfaces (GET /api/webhooks/url, agent cards, /.well-known/agent.json) fall
# back to the request host. The runtime never falls back to a CodeSpar host
# (no phone-home). Note: docker compose does not read this file automatically,
# so also set it in the compose `environment:` block or pass an env_file.
WEBHOOK_BASE_URL=

# Where YOUR dashboard lives (e.g. https://ops.yourco.com). Only used to send
# the browser somewhere after a Slack/GitHub OAuth flow. Leave blank and the
# runtime renders its own "connected" page instead of redirecting anywhere.
# There is no default: the runtime must never redirect you to a CodeSpar page.
DASHBOARD_URL=

# Boolean, default false. Leave it blank unless a reverse proxy you control is
# the ONLY way to reach this runtime and it overwrites x-forwarded-proto and
# x-forwarded-host on every request it forwards. Enabled, those headers are
# honoured from whoever opened the socket, so anyone who can reach this port
# directly steers the URLs the runtime shows. Blank means the headers are
# ignored. Only the boolean spellings are accepted (true/1/on/yes,
# false/0/off/no); a hop count or an IP/CIDR list is rejected at startup with a
# message naming this variable, because the proxy-chain policy has to mean the
# same thing to Fastify and to the base-URL helper. Restrict which peers may
# reach this port in the proxy or the firewall, not here. Rate limiting is
# keyed by the socket peer and is unaffected by this setting.
TRUST_PROXY=

# Name this install announces on the A2A network at /.well-known/agent.json.
# Blank means the generic default; set it to your own so peers do not see
# somebody else's brand.
AGENT_CARD_NAME=

# Optional: transactional email (newsletter opt-in, lead notifications) via
# Resend. Both are required for anything to be sent; there is no default sender
# identity, so nothing is ever mailed from a CodeSpar address. With either one
# blank the welcome email and the lead notification are silently not sent, which
# is the intended default for a fresh install.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: subject line of the newsletter welcome email. Blank uses a generic
# default. Only read when the two RESEND_* values above are both set.
NEWSLETTER_SUBJECT=

# WhatsApp (via Evolution API)
ENABLE_WHATSAPP=false
EVOLUTION_API_URL=http://localhost:8084
EVOLUTION_API_KEY=your_api_key_here
EVOLUTION_INSTANCE=codespar
WHATSAPP_WEBHOOK_PORT=3001
WHATSAPP_BOT_MENTION=@codespar
# Webhook URL Evolution API POSTs inbound events to. Leave WHATSAPP_WEBHOOK_URL
# blank to derive from WHATSAPP_WEBHOOK_HOST + WHATSAPP_WEBHOOK_PORT. In compose
# set WHATSAPP_WEBHOOK_HOST to the runtime service name (e.g. "core").
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_HOST=host.docker.internal
# Webhook security (F10.M3 / #364). Set EVOLUTION_WEBHOOK_SECRET to a strong
# random value in production; share the same value with the evolution-api
# service. When STRICT_MODE=true the route rejects unsigned requests with 401
# even if the secret is unset (production failsafe).
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_STRICT_MODE=false
# Idle TTL for durable per-(project, channelUser) sessions, in days. The
# bridge closes sessions whose lastActivityAt is older than this on next lookup
# (F10.M4 / #366). Default 30.
WHATSAPP_SESSION_IDLE_TTL_DAYS=30

# Optional: Slack
ENABLE_SLACK=false
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Optional: Telegram
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=

# Optional: Discord
ENABLE_DISCORD=false
DISCORD_BOT_TOKEN=

# Database (auto-configured in Docker)
DATABASE_URL=postgres://codespar:codespar_dev@localhost:5432/codespar
REDIS_URL=redis://localhost:6379

# Server
PORT=3000

# Working directory for Claude Code (defaults to process.cwd())
CODESPAR_WORK_DIR=

# Default project name
PROJECT_NAME=default
